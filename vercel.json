{
  "redirects": [
    { "source": "/project/ogsera", "destination": "/project/edutams-essential-v2", "permanent": true },
    { "source": "/project/portfolio-website", "destination": "/", "permanent": true },
    { "source": "/project/conference-ticket-generator", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=UTF-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=UTF-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|.*\\..*|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
